rules_version = '2';

// Each user can only read/write their own follow-ups and R&D items, which live
// under users/{uid}/...  Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
