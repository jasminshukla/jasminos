{
  "expo": {
    "name": "JasminOs",
    "slug": "todos",
    "version": "1.0.0",
    "scheme": "exporeactnative",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jasminos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jasminos",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#5B8CFF"
        }
      ],
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow JasminOs to pick a contact for your follow-ups."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aafb3621-d312-4a63-bfe2-79e5aac7aa1e"
      }
    },
    "owner": "jasmin",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aafb3621-d312-4a63-bfe2-79e5aac7aa1e"
    }
  }
}
